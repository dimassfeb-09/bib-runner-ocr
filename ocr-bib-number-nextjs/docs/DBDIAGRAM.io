// === MASTER DATA TABLES ===

Table admins {
  id integer [primary key, increment]
  username varchar [not null, unique]
  password_hash varchar [not null]
  created_at timestamp [default: `now()`]
}

Table events {
  id integer [primary key, increment]
  name varchar [not null]
  event_date date [not null]
  location varchar
  bundle_price decimal [default: null]
  created_at timestamp [default: `now()`]
}

Table settings {
  key varchar [primary key]
  value text [not null]
}

// === CORE TRANSACTION & RUNNER DATA ===

Table photos {
  id integer [primary key, increment]
  event_id integer [not null]
  original_url text [not null, note: "URL to private bucket in Supabase Storage"]
  watermark_url text [not null, note: "URL to public bucket in Supabase Storage"]
  price decimal [default: null]
  uploaded_at timestamp [default: `now()`]
}

Table bib_numbers {
  id integer [primary key, increment]
  event_id integer [not null]
  number varchar [not null]
  price decimal [default: null, note: "Custom bundle price for this BIB in this event"]
}

Table photo_bibs {
  photo_id integer [not null]
  bib_number_id integer [not null]
  bbox "integer[]" [default: null]
  
  Indexes {
    (photo_id, bib_number_id) [pk]
  }
}

Table orders {
  id varchar [primary key, note: "Transaction ID generated by system or Midtrans"]
  buyer_email varchar [not null]
  payment_status varchar [default: 'pending', note: "Enum: 'pending', 'settlement', 'expire', 'deny'"]
  total_amount decimal [not null]
  download_token uuid [unique, not null]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table order_items {
  id integer [primary key, increment]
  order_id varchar [not null]
  photo_id integer [note: "Set NULL if photo is deleted to keep history"]
}

Table unrecognized_bibs {
  id integer [primary key, increment]
  photo_id integer [not null]
  suggested_number varchar [not null]
  confidence_score decimal [not null, note: "E.g., 0.4500"]
  status varchar [default: 'pending', note: "Enum: 'pending', 'accepted', 'rejected'"]
  bbox "integer[]" [default: null]
  created_at timestamp [default: `now()`]
}

// === RELATIONSHIPS (FOREIGN KEYS) ===

Ref: photos.event_id > events.id [delete: cascade]
Ref: bib_numbers.event_id > events.id [delete: cascade]

Ref: photo_bibs.photo_id > photos.id [delete: cascade]
Ref: photo_bibs.bib_number_id > bib_numbers.id [delete: cascade]

Ref: order_items.order_id > orders.id [delete: cascade]
Ref: order_items.photo_id > photos.id [delete: set null]

Ref: unrecognized_bibs.photo_id > photos.id [delete: cascade]


// === INITIAL DATA RECORDS (CONNECTED DUMMY RECORDS) ===

Records admins(id, username, password_hash) {
  1, 'admin', '$2b$10$hashed_password_placeholder'
}

